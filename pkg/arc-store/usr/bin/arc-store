#!/usr/bin/env python3
"""
arc-store — launcher.

Resolves where Arc Store's Python files are actually installed and hands
off to their main.py. Kept separate from main.py itself so the PKGBUILD's
install rule (usr/bin/* -> mode 755, everything else -> 644) lines up with
the two files' actual roles: this one is the executable entry point,
main.py is a plain importable module living next to its own package's
files (theme.py, package_manager.py, icon.png, widgets/, auth/, i18n/).
"""

import os
import sys

# GTK4's default Vulkan-backed GSK renderer is known to abort inside
# gtk_widget_allocate on NVIDIA's proprietary driver (documented on the
# ArchWiki's GTK page, the Arch Linux forums, and NVIDIA's own developer
# forum). Falling back to the GL renderer is the standard workaround.
# Set as a *default* — os.environ.setdefault leaves it alone if the user
# (or a saner future driver release) already set GSK_RENDERER themselves.
# This has to happen before gi/Gtk is imported anywhere, which is exactly
# why it lives here rather than in main.py.
os.environ.setdefault("GSK_RENDERER", "gl")

_THIS_DIR = os.path.dirname(os.path.abspath(__file__))

APP_DIR_CANDIDATES = [
    "/usr/share/arc-store",
    os.path.normpath(os.path.join(_THIS_DIR, "..", "share", "arc-store")),
]


def _resolve_app_dir() -> str:
    for candidate in APP_DIR_CANDIDATES:
        if os.path.isfile(os.path.join(candidate, "main.py")):
            return candidate
    raise FileNotFoundError(
        "Could not find Arc Store's application directory (main.py not found in: "
        + ", ".join(APP_DIR_CANDIDATES) + ")"
    )


def main():
    app_dir = _resolve_app_dir()
    sys.path.insert(0, app_dir)
    from main import main as run_app  # arc-store/main.py, now first on sys.path
    return run_app()


if __name__ == "__main__":
    sys.exit(main() or 0)
